# Normalise line endings in the repository; editors may check out CRLF on Windows.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# Preserve the upstream font license verbatim, including its original spacing.
public/fonts/courier-badi/OFL.txt -whitespace
