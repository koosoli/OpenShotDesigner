{
  "name": "open-shotdesigner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Open Shot Designer — a free, open-source 2D film floor plan & shot list designer. Block scenes, plan camera moves, and export production-ready blueprints.",
  "license": "GPL-3.0",
  "homepage": "https://koosoli.github.io/OpenShotDesigner/",
  "repository": {
    "type": "git",
    "url": "https://github.com/koosoli/OpenShotDesigner.git"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:playwright": "node scripts/check-playwright-version.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit && eslint . --max-warnings=0 && node scripts/check-encoding.mjs",
    "lint:fix": "eslint . --fix",
    "check:encoding": "node scripts/check-encoding.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:offline": "playwright test --config=playwright.offline.config.ts",
    "test:e2e:firefox": "playwright test --config=playwright.firefox.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "fixtures:build": "tsx scripts/build-fixture-db.ts",
    "check:commands": "node scripts/check-command-ratchet.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
